# Copy to .env and adjust. Every value can also be set as an environment variable.

# --- Application -----------------------------------------------------------
APP_NAME=Workspace
APP_TAGLINE=Operations dashboard
# development | test | production   (production enforces the safety checks below)
APP_ENV=development
LOG_LEVEL=INFO
# text (readable) or json (one object per line, for log collectors). Default: json in production.
# LOG_FORMAT=json

# --- Secrets / database ----------------------------------------------------
# REQUIRED in production: at least 32 random chars.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# SQLite by default. For Postgres: postgresql+psycopg://user:pass@host:5432/db
# (add psycopg[binary] to requirements.in)
# Default: SQLite at <project>/data/app.db
# DATABASE_URL=sqlite:////absolute/path/app.db
# Run Alembic migrations on startup. Keep false if you run several workers
# and migrate as a separate deploy step (`alembic upgrade head`).
AUTO_MIGRATE=true

# --- Authentication --------------------------------------------------------
# Set to false to skip login during development. It ONLY takes effect if the
# sentinel file below exists AND APP_ENV is not production. The file is
# git-ignored and docker-ignored, so it can never reach a server.
#   create:  touch .auth-bypass      remove: rm .auth-bypass
AUTH_ENABLED=true
AUTH_BYPASS_FILE=.auth-bypass

# Initial registration needs the one-time token printed in the server log.
# Defaults to true in production, false otherwise. Optionally pin a token:
# SETUP_TOKEN_REQUIRED=true
# SETUP_TOKEN=

SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Email (forgot password, email 2FA codes, security notices) -------------
# console:   DEVELOPMENT ONLY. Emails (with reset links and codes) are printed to
#            the server log. Production refuses to start with it.
# microsoft: Microsoft 365 / Outlook via Microsoft Graph. In Entra ID (Azure AD):
#            App registrations -> New registration -> API permissions -> Microsoft
#            Graph -> Application -> Mail.Send -> Grant admin consent; then create a
#            client secret. SENDER_EMAIL is the mailbox the mail is sent from.
# disabled:  no email; "Forgot password?" and email 2FA codes are hidden.
MAIL_PROVIDER=console
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
SENDER_EMAIL=
# Base URL used in emailed links (https:// in production).
PUBLIC_URL=http://localhost:8000
PASSWORD_RESET_MINUTES=30

# --- Sign in with Microsoft (OpenID Connect / Microsoft Entra ID) -------------
# Adds a "Sign in with Microsoft" button to the login page. Only accounts whose
# email domain is listed in MICROSOFT_SSO_ALLOWED_DOMAINS can sign in this way;
# email + password sign-in keeps working as before.
# Entra ID -> App registrations -> (new or the mail one) -> Authentication ->
#   Add a platform -> Web -> Redirect URI: {PUBLIC_URL}/api/auth/microsoft/callback
#   then Certificates & secrets -> New client secret.
# TENANT_ID / CLIENT_ID / CLIENT_SECRET fall back to AZURE_* above when empty.
MICROSOFT_SSO_ENABLED=false
# Your tenant GUID (recommended). "organizations" accepts any work/school tenant
# and then needs MICROSOFT_SSO_ALLOWED_TENANT_IDS in production.
MICROSOFT_SSO_TENANT_ID=
MICROSOFT_SSO_CLIENT_ID=
MICROSOFT_SSO_CLIENT_SECRET=
# Comma separated, required when enabled, e.g. example.com,example.org
MICROSOFT_SSO_ALLOWED_DOMAINS=
# MICROSOFT_SSO_ALLOWED_TENANT_IDS=
# Empty: only users an admin already added can sign in (matched by email, then
# linked to their Microsoft account). A role name, e.g. Member: people from the
# allowed domains get an account with that role on first sign-in.
MICROSOFT_SSO_AUTO_CREATE_ROLE=

# --- Two-factor authentication (optional per user, chosen in Settings) ------
MFA_CODE_MINUTES=10
# Name shown in authenticator apps (defaults to APP_NAME).
# MFA_ISSUER=

# --- Cloudflare Turnstile (bot protection on login and first-run setup) ------
# These are Cloudflare's public TEST keys: the widget always passes, so local
# dev and CI work without an account. Production REFUSES to start with them.
# Get real keys at https://dash.cloudflare.com -> Turnstile, then set both.
#   1x00000000000000000000AA / 1x0000000000000000000000000000000AA  always passes
#   2x00000000000000000000AB / 2x0000000000000000000000000000000AA  always blocks
#   3x00000000000000000000FF / 3x0000000000000000000000000000000AA  forces an interactive challenge
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- HTTP hardening --------------------------------------------------------
# Comma separated. Production: your real domain(s), https only.
ALLOWED_HOSTS=localhost,127.0.0.1
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Defaults to true in production (Secure + __Host- cookies, HSTS).
# COOKIE_SECURE=
# Swagger UI at /api/docs. Defaults to off in production.
# ENABLE_API_DOCS=
MAX_BODY_BYTES=1048576
